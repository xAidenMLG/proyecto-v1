 "meta": {
  "name": "Neon Rain (v2)",
  "description": "Dark synthwave / cinematic electronic con toques neo-soul. Version hibrida: la especificacion original de Neon Rain (92 BPM, Dm eolico, i-VI-III-VII / iv-VII-III-VI / i-v-VI-VII con 7a y 9a) mas las tecnicas de Shadow Corner (bends, slides de bajo, voicings abiertos full/bare, cromatismos, clusters, tape-stop, validacion). Composicion original.",
  "source_files": [
   "Neon_Rain_v2.mid",
   "Neon_Rain_v2.wav",
   "Neon_Rain_v2.mp3",
   "neon_rain_v2_events.json"
  ],
  "note": "Las secciones suman 88 compases (3:50 a 92 BPM), no los 2:15 del pedido original.",
  "inherited_from_neon_rain_v1": [
   "BPM 92, 4/4, Re eolico",
   "progresiones pedidas",
   "bajo root+quinta sincopado en 1 y la \"y\" del 2",
   "arpegio de corcheas en versos",
   "dinamica por seccion (coros 94-110)",
   "verificacion automatica de choques de semitono"
  ],
  "inherited_from_shadow_corner": [
   "pitch bends (scoop/caida) en el lead",
   "slide de tono entero en el bajo",
   "voicings de strings abiertos alternando full/bare",
   "pad raiz+quinta en versos",
   "aproximaciones cromaticas en el bajo",
   "clusters de 2a menor (Eb sobre Dm, Bb sobre Am) y dyads D/Eb",
   "snare retrasado y kick adelantado",
   "hats irregulares (20% arrastrados) y omision de open hats",
   "desafinacion fina por pista",
   "tape-stop final",
   "bloque de validacion",
   "textura de ruido en el render (aqui: lluvia)"
  ]
 },
